# Local Convex development. `npx convex dev --configure` normally manages these.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Browser-visible Clerk key. Never place CLERK_SECRET_KEY in a VITE_ variable.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional browser analytics. Use the regional ingestion host, not the PostHog UI host.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Optional local-only analytics logging. Set to true only while debugging locally.
VITE_POSTHOG_DEBUG=

# Server-only Clerk/Convex configuration. Store production values in Clerk/Convex.
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Server-only integrations. Store production values in the Convex environment.
DATAGOLF_API_KEY=
BREVO_API_KEY=
BREVO_TEST_TO=
BREVO_GROUPS_FINALIZED_TEMPLATE_ID=
BREVO_WEEKLY_RECAP_TEMPLATE_ID=
BREVO_MISSING_TEAM_REMINDER_TEMPLATE_ID=
BREVO_SEASON_START_TEMPLATE_ID=

# Public application origin used by server-generated links.
APP_BASE_URL=

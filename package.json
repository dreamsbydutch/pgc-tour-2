{
  "name": "pgc-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "start": "node .output/server/index.mjs",
    "build": "vite build",
    "bundle:analyze": "node scripts/create-bundle-analysis.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "convex:io-check": "node scripts/check-convex-io.mjs",
    "docs:check": "node scripts/check-agent-docs.mjs",
    "postbuild": "node scripts/patch-vercel-function-runtime.mjs",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint src convex scripts --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src convex scripts --ext .ts,.tsx,.js,.jsx --fix",
    "lint:strict": "eslint src convex scripts --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "security:dependencies": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run docs:check && npm run lint:strict && npm run typecheck && npm test && npm run convex:io-check && npm run build && npm run bundle:analyze && npm run bundle:budget"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.13",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.45.0",
    "lucide-react": "^1.45.0",
    "nitro": "^3.0.260610-beta",
    "posthog-js": "^1.430.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "convex-test": "^0.0.58",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "web-vitals": "^6.2.1"
  }
}

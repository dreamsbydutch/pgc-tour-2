{
  "name": "pgc-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "start": "node .output/server/index.mjs",
    "build": "vite build",
    "bundle:analyze": "node scripts/create-bundle-analysis.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "convex:io-check": "node scripts/check-convex-io.mjs",
    "postbuild": "node scripts/patch-vercel-function-runtime.mjs",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint src convex scripts --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src convex scripts --ext .ts,.tsx,.js,.jsx --fix",
    "lint:strict": "eslint src convex scripts --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "security:dependencies": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint:strict && npm run typecheck && npm test && npm run convex:io-check && npm run build && npm run bundle:analyze && npm run bundle:budget"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.42.3",
    "lucide-react": "^0.543.0",
    "nitro": "^3.0.260610-beta",
    "posthog-js": "^1.262.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@tanstack/react-devtools": "^0.10.9",
    "@types/node": "^24.3.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.21",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.5",
    "vite-tsconfig-paths": "^6.1.1",
    "web-vitals": "^4.2.4"
  }
}
